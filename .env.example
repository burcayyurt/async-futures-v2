# Web3 / Hyperliquid Agent
WALLET_ADDRESS=
AGENT_PRIVATE_KEY=

# Endpoints (Mainnet)
HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws
HL_TESTNET=false

# Perpetual defaults
LEVERAGE=10
MARGIN_MODE=isolated
# Comma-separated perp symbols (2 WS subscriptions per coin: trades + activeAssetCtx)
BOT_SYMBOLS=BTC,ETH,SOL,NEAR,AVAX,DOGE,LINK,INJ,SUI,SEI,APT
BOT_DRY_RUN=true

# Logging
LOG_LEVEL=INFO

# Trade journal (append-only closed trade history)
TRADE_JOURNAL_PATH=data/trades.jsonl
OPEN_POSITIONS_PATH=data/open_positions.json

# Telegram command polling (/stats, /positions, /help)
TELEGRAM_POLL_ENABLED=true
TELEGRAM_POLL_INTERVAL_SECONDS=3

# Telegram (optional — leave empty to disable notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk / execution
MAX_DRAWDOWN_PCT=2.0
TRADE_RISK_PCT=1.0
TRAILING_CALLBACK_PCT=0.006
BREAK_EVEN_TRIGGER_PCT=0.5

# Feed-health guards (HTTP 502 / WS blackout protection)
# Suppress new entries for N seconds after each (re)connect (avoids stale/burst
# data firing false signals). 0 disables.
WS_RECONNECT_ENTRY_COOLDOWN_SECONDS=15
# If the mark feed gaps for longer than this (seconds), don't fire a hard stop on
# the first gapped tick after the blackout (it would exit at a discontinuity).
MARK_STALENESS_GAP_SECONDS=5.0
# Minimum hold before a hard stop can fire (kill-switch overrides). 0 disables.
MIN_HOLD_SECONDS=0

# Strategy (momentum + OI breakout)
STRATEGY_WINDOW_SECONDS=60
STRATEGY_PRICE_DELTA=0.8
STRATEGY_VOLUME_SPIKE=2.0
STRATEGY_MIN_OI_INCREASE=0.05
STRATEGY_REGIME_COIN=BTC
STRATEGY_EMA_PERIOD=20
STRATEGY_REGIME_BUFFER_PCT=0.15
STRATEGY_MIN_TRADES=3

# Correlation-trap guard (applies to both engines). Skip a signal when this many
# *other* symbols moved the same direction inside the window (market beta).
CORRELATION_GUARD_ENABLED=true
CORRELATION_WINDOW_SECONDS=120
CORRELATION_MAX_SAME_SIDE=4

# --- Strategy engine selection: "dvsla" (live) or "momentum" (legacy/AB). ---
STRATEGY_ENGINE=dvsla
# DVSLA direction: false = fade the cascade (mean-reversion), true = momentum.
DVSLA_INVERT=false
# In fade mode, veto signals when OI is strongly expanding (fresh trend money).
DVSLA_FADE_OI_Z_VETO=true
# Shock robustness: min absolute bar return (fraction) + z-score hard cap.
# Together these neutralize variance-collapse z-score blow-ups.
DVSLA_RET_MIN_ABS_PCT=0.0015
DVSLA_RET_Z_CLAMP=25
# Reject entries with |ret_z| at/above this (clamp-ceiling artefacts, not real
# cascades). 0 disables; keep below DVSLA_RET_Z_CLAMP.
DVSLA_RET_Z_REJECT=20
