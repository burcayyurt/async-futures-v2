# Web3 / Hyperliquid Agent
WALLET_ADDRESS=
AGENT_PRIVATE_KEY=

# Endpoints (Mainnet)
HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws
HL_TESTNET=false

# Perpetual defaults
LEVERAGE=10
MARGIN_MODE=isolated
# Comma-separated perp symbols (2 WS subscriptions per coin: trades + activeAssetCtx)
BOT_SYMBOLS=BTC,ETH,SOL,NEAR,AVAX,DOGE,LINK,INJ,SUI,SEI,APT
BOT_DRY_RUN=true

# Logging
LOG_LEVEL=INFO

# Trade journal (append-only closed trade history)
TRADE_JOURNAL_PATH=data/trades.jsonl
OPEN_POSITIONS_PATH=data/open_positions.json

# Telegram command polling (/stats, /positions, /help)
TELEGRAM_POLL_ENABLED=true
TELEGRAM_POLL_INTERVAL_SECONDS=3

# Telegram (optional — leave empty to disable notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk / execution
MAX_DRAWDOWN_PCT=2.0
TRADE_RISK_PCT=1.0
TRAILING_CALLBACK_PCT=0.006
BREAK_EVEN_TRIGGER_PCT=0.5

# Strategy (momentum + OI breakout)
STRATEGY_WINDOW_SECONDS=60
STRATEGY_PRICE_DELTA=0.8
STRATEGY_VOLUME_SPIKE=2.0
STRATEGY_MIN_OI_INCREASE=0.05
STRATEGY_REGIME_COIN=BTC
STRATEGY_EMA_PERIOD=20
STRATEGY_REGIME_BUFFER_PCT=0.15
STRATEGY_MIN_TRADES=3
